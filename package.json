{
  "name": "how-many-tokens",
  "version": "1.0.0",
  "description": "Count tokens for text across different LLM providers",
  "type": "module",
  "bin": {
    "how-many-tokens": "./src/index.ts",
    "hmt": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "compile": "bun build src/index.ts --compile --outfile dist/hmt",
    "install-local": "./install.sh"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "picocolors": "^1.1.1",
    "tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "keywords": ["tokens", "llm", "openai", "anthropic", "cli", "tiktoken"],
  "license": "MIT"
}
